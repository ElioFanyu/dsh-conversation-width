{
  "name": "dsh-conversation-width",
  "version": "1.0.1",
  "description": "Conversation display-area width control for DSH — adds a General Settings row that sets the transcript column width, sharing one preference with the built-in drag handles.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "dsh": {
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.2": "compatible",
        "0.2.1-rc.2": "compatible",
        "0.2.1-rc.3": "compatible",
        "0.2.1-rc.5": "compatible"
      }
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "manifestVersion": 1
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/en.json",
    "locale/zh.json",
    "README.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-client-locale": ">=0.2.0-rc.2 <0.3.0",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "license": "MIT",
  "author": "ElioFanyu",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/ElioFanyu/dsh-conversation-width.git"
  },
  "homepage": "https://github.com/ElioFanyu/dsh-conversation-width#readme",
  "bugs": {
    "url": "https://github.com/ElioFanyu/dsh-conversation-width/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "ui",
    "settings",
    "conversation-width"
  ]
}
